# Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="SarkarSetu AI"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sarkarsetu
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# External APIs - Gemini
# Set GEMINI_ENABLED=true and provide GEMINI_API_KEY to enable AI features
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Security - JWT
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password Hashing (Argon2id)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Password Policy
MIN_PASSWORD_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_DIGITS=true
REQUIRE_SPECIAL_CHARS=true

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# Knowledge Retrieval
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.3
KNOWLEDGE_RETRIEVAL_RERANK=true
KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=10
KNOWLEDGE_RETRIEVAL_DEV_FIXTURE=true